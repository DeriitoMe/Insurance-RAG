# ===================================================================
#  环境变量模板
#
#  用法：复制成 .env，保持默认值可离线预览；要接 API 时再按下方说明修改。
#    copy .env.example .env        (Windows)
#    cp .env.example .env          (macOS / Linux)
#  本地脚本和启动.bat 会自动读取项目根目录的 .env；进程环境变量优先。
#
#  ⚠️ .env 已经在 .gitignore 里，**不会**被提交到 GitHub。
#     千万不要把密钥写进 .env.example 或任何会被提交的文件。
# ===================================================================

# ---------------- 向量模型 ----------------
# hash  = 零依赖占位实现。能跑通链路，但**检索效果差**，评测数字无意义
# api   = OpenAI 兼容接口（填好 key 后启用）
# local = sentence-transformers 本地模型（数据不出内网，需装 torch）
PR_EMB_PROVIDER=hash

# 硅基流动 / 智谱 / 通义 / 本地 vLLM 都可以，填对应的 base url
PR_EMB_API_BASE=https://api.siliconflow.cn/v1
PR_EMB_API_KEY=
PR_EMB_MODEL=BAAI/bge-m3

# ---------------- 生成模型 ----------------
# mock = 不调真实模型，返回占位文本（离线演示用）
# api  = OpenAI 兼容接口（填好 key 后启用）
PR_LLM_PROVIDER=mock
PR_LLM_API_BASE=https://api.deepseek.com/v1
PR_LLM_API_KEY=
PR_LLM_MODEL=deepseek-chat
PR_LLM_TEMP=0.0

# ---------------- 切分参数 ----------------
PR_MAX_CHARS=800
PR_MIN_CHARS=60
PR_INJECT_PATH=1

# ---------------- 检索参数 ----------------
PR_TOP_K=20
PR_TOP_N=5
PR_USE_BM25=1
PR_USE_RERANK=0
